rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function getUserData() {
      return get(userPath(request.auth.uid)).data;
    }

    function isActive() {
      return isAuthenticated()
        && exists(userPath(request.auth.uid))
        && getUserData().status == 'ACTIVE';
    }

    function isAdmin() {
      return isActive() && getUserData().role == 'ADMIN';
    }

    function isBootstrapAdminEmail() {
      return isAuthenticated()
        && request.auth.token.email in ['duykhuong332@gmail.com', 'admin@company.com'];
    }

    function projectPath(projectId) {
      return /databases/$(database)/documents/projects/$(projectId);
    }

    function taskPath(taskId) {
      return /databases/$(database)/documents/tasks/$(taskId);
    }

    function isProjectMember(projectId) {
      return isAdmin() || (
        isActive()
        && exists(projectPath(projectId))
        && request.auth.uid in get(projectPath(projectId)).data.memberIds
      );
    }

    function isProjectOwner(projectId) {
      return isAdmin() || (
        isActive()
        && exists(projectPath(projectId))
        && get(projectPath(projectId)).data.ownerId == request.auth.uid
      );
    }

    function canReadTaskData(taskData) {
      return isAdmin() || (
        isActive()
        && request.auth.uid in taskData.projectMemberIds
        && isProjectMember(taskData.projectId)
      );
    }

    function canReadTask(taskId) {
      return exists(taskPath(taskId)) && canReadTaskData(get(taskPath(taskId)).data);
    }

    // ---------------------------------------------------------------------
    // User profiles / internal directory
    // ---------------------------------------------------------------------
    match /users/{userId} {
      // Active internal users need basic directory data to render assignees,
      // project members and avatars. No passwords/tokens are stored here.
      allow read: if isAdmin()
        || (isAuthenticated() && request.auth.uid == userId)
        || isActive();

      allow create: if isAuthenticated()
        && request.auth.uid == userId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.googleUid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.auth.token.email_verified == true
        && request.resource.data.provider == 'google'
        && (
          (
            isBootstrapAdminEmail()
            && request.resource.data.role == 'ADMIN'
            && request.resource.data.status == 'ACTIVE'
          )
          ||
          (
            !isBootstrapAdminEmail()
            && request.resource.data.role == 'MEMBER'
            && request.resource.data.status == 'PENDING_APPROVAL'
          )
        );

      // role/status remain admin-owned. A user may refresh only identity fields.
      allow update: if isAdmin() || (
        isAuthenticated()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'email', 'normalizedEmail', 'displayName', 'photoURL', 'provider', 'lastLoginAt', 'updatedAt'
        ])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.provider == 'google'
      );
      allow delete: if false;
    }

    // ---------------------------------------------------------------------
    // Projects
    // memberIds is a denormalized query/security index; members retains role data.
    // ---------------------------------------------------------------------
    match /projects/{projectId} {
      allow read: if isAdmin() || (
        isActive() && request.auth.uid in resource.data.memberIds
      );

      allow create: if isActive()
        && request.resource.data.ownerId == request.auth.uid
        && request.auth.uid in request.resource.data.memberIds;

      // Membership and project metadata are owner/admin managed. ownerId cannot
      // be silently transferred by a normal client update.
      allow update: if isAdmin() || (
        isActive()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
      );

      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------------------
    // Tasks + task-scoped collaboration subcollections
    // ---------------------------------------------------------------------
    match /tasks/{taskId} {
      allow read: if canReadTaskData(resource.data);

      allow create: if isActive()
        && request.resource.data.taskId == taskId
        && request.resource.data.assignerId == request.auth.uid
        && request.resource.data.assigneeIds.size() > 0
        && isProjectMember(request.resource.data.projectId)
        && request.auth.uid in request.resource.data.projectMemberIds
        && request.resource.data.projectMemberIds == get(projectPath(request.resource.data.projectId)).data.memberIds;

      // Assigner/Admin owns workflow completion and core task fields.
      // Assignees may only move non-completed execution state/progress.
      // Project owners may do the same and may refresh projectMemberIds after
      // membership changes so existing tasks become visible/invisible correctly.
      allow update: if canReadTaskData(resource.data)
        && request.resource.data.taskId == resource.data.taskId
        && request.resource.data.projectId == resource.data.projectId
        && request.resource.data.assignerId == resource.data.assignerId
        && (
          request.resource.data.projectMemberIds == resource.data.projectMemberIds
          || (
            (isAdmin() || isProjectOwner(resource.data.projectId))
            && request.resource.data.projectMemberIds == get(projectPath(resource.data.projectId)).data.memberIds
          )
        )
        && (
          isAdmin()
          || request.auth.uid == resource.data.assignerId
          || (
            request.auth.uid in resource.data.assigneeIds
            && request.resource.data.projectMemberIds == resource.data.projectMemberIds
            && request.resource.data.status != 'COMPLETED'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'progressSummary', 'updatedAt'
            ])
          )
          || (
            isProjectOwner(resource.data.projectId)
            && request.resource.data.status != 'COMPLETED'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'progressSummary', 'updatedAt', 'projectMemberIds'
            ])
          )
        );

      allow delete: if isAdmin() || resource.data.assignerId == request.auth.uid;

      match /assignments/{assigneeUid} {
        allow read: if canReadTask(taskId);

        // Assignment identity is immutable and tied to its task/document id.
        // Assignees can report progress / hand over work, but cannot self-approve
        // COMPLETED or forge approval/revision fields.
        allow create: if canReadTask(taskId)
          && request.resource.data.taskId == taskId
          && request.resource.data.userId == assigneeUid
          && (
            isAdmin()
            || request.auth.uid == get(taskPath(taskId)).data.assignerId
            || (
              request.auth.uid == assigneeUid
              && request.resource.data.status in ['NOT_STARTED', 'IN_PROGRESS', 'WAITING', 'SUBMITTED']
              && !('completedAt' in request.resource.data)
              && !('revisionRequestedAt' in request.resource.data)
              && !('revisionNote' in request.resource.data)
            )
          );

        allow update: if canReadTask(taskId)
          && request.resource.data.taskId == resource.data.taskId
          && request.resource.data.userId == resource.data.userId
          && resource.data.taskId == taskId
          && resource.data.userId == assigneeUid
          && (
            isAdmin()
            || request.auth.uid == get(taskPath(taskId)).data.assignerId
            || (
              request.auth.uid == assigneeUid
              && request.resource.data.status in ['NOT_STARTED', 'IN_PROGRESS', 'WAITING', 'SUBMITTED']
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'status', 'progress', 'startedAt', 'submittedAt', 'submissionNote', 'updatedAt'
              ])
            )
          );

        allow delete: if isAdmin() || request.auth.uid == get(taskPath(taskId)).data.assignerId;
      }

      match /messages/{messageId} {
        allow read: if canReadTask(taskId);

        allow create: if canReadTask(taskId)
          && request.resource.data.taskId == taskId
          && request.resource.data.messageId == messageId
          && request.resource.data.senderId == request.auth.uid
          && (
            !('chatWritableUntil' in get(taskPath(taskId)).data)
            || request.time <= get(taskPath(taskId)).data.chatWritableUntil
          );

        // Sender may edit message content/mentions or soft-delete their own
        // message, but cannot rewrite identity/timestamps of authorship.
        allow update: if canReadTask(taskId)
          && resource.data.senderId == request.auth.uid
          && request.resource.data.senderId == resource.data.senderId
          && request.resource.data.taskId == resource.data.taskId
          && request.resource.data.messageId == resource.data.messageId
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'text', 'mentions', 'replyToMessageId', 'attachmentIds', 'editedAt', 'deleted', 'deletedAt'
          ])
          && (
            !('chatWritableUntil' in get(taskPath(taskId)).data)
            || request.time <= get(taskPath(taskId)).data.chatWritableUntil
          );

        allow delete: if isAdmin() || (
          canReadTask(taskId) && resource.data.senderId == request.auth.uid
        );
      }

      match /files/{fileId} {
        allow read: if canReadTask(taskId);

        allow create: if canReadTask(taskId)
          && request.resource.data.fileId == fileId
          && request.resource.data.taskId == taskId
          && request.resource.data.projectId == get(taskPath(taskId)).data.projectId
          && request.resource.data.uploadedBy == request.auth.uid
          && request.resource.data.size > 0
          && request.resource.data.size <= 25 * 1024 * 1024;

        // File binary + immutable metadata live in Storage. Firestore updates are
        // limited to soft-delete metadata so a client cannot retarget a metadata
        // record to another object/uploader/project.
        allow update: if canReadTask(taskId)
          && request.resource.data.fileId == resource.data.fileId
          && request.resource.data.taskId == resource.data.taskId
          && request.resource.data.projectId == resource.data.projectId
          && request.resource.data.uploadedBy == resource.data.uploadedBy
          && request.resource.data.storagePath == resource.data.storagePath
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'deleted', 'deletedAt', 'deletedBy'
          ])
          && (
            isAdmin()
            || resource.data.uploadedBy == request.auth.uid
            || get(taskPath(taskId)).data.assignerId == request.auth.uid
          );

        allow delete: if isAdmin() || (
          canReadTask(taskId)
          && (
            resource.data.uploadedBy == request.auth.uid
            || get(taskPath(taskId)).data.assignerId == request.auth.uid
          )
        );
      }
    }

    // ---------------------------------------------------------------------
    // Per-user notifications
    // ---------------------------------------------------------------------
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;

      allow update: if isAuthenticated()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.notificationId == resource.data.notificationId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'read', 'deliveryStatus'
        ]);

      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;

      allow create: if isActive()
        && request.resource.data.notificationId == notificationId
        && request.resource.data.createdBy == request.auth.uid;
    }

    // ---------------------------------------------------------------------
    // Immutable audit trail
    // ---------------------------------------------------------------------
    match /auditLogs/{eventId} {
      allow read: if isAdmin();
      allow create: if isActive()
        && request.resource.data.eventId == eventId
        && request.resource.data.actorId == request.auth.uid;
      allow update, delete: if false;
    }

    match /deviceTokens/{tokenId} {
      allow read, delete: if isAuthenticated()
        && resource.data.uid == request.auth.uid;
      allow create: if isAuthenticated()
        && request.resource.data.uid == request.auth.uid;
      allow update: if isAuthenticated()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid;
    }
  }
}
