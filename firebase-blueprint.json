{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with role-based access control and Google account metadata",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "googleUid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "normalizedEmail": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "role": { "type": "string", "enum": ["ADMIN", "MEMBER"] },
        "status": { "type": "string", "enum": ["INVITED", "ACTIVE", "DISABLED", "PENDING_APPROVAL"] },
        "provider": { "type": "string", "enum": ["google"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "displayName", "role", "status", "createdAt", "updatedAt"]
    },
    "Project": {
      "title": "Project",
      "description": "Workspace project entity managing member permissions and task groupings",
      "type": "object",
      "properties": {
        "projectId": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "ownerId": { "type": "string" },
        "status": { "type": "string", "enum": ["ACTIVE", "COMPLETED", "ARCHIVED"] },
        "deleted": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["projectId", "name", "ownerId", "status", "createdAt", "updatedAt"]
    },
    "Task": {
      "title": "Task",
      "description": "Task unit assigned to one or more members with priority and deadline",
      "type": "object",
      "properties": {
        "taskId": { "type": "string" },
        "projectId": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "assignerId": { "type": "string" },
        "assigneeIds": { "type": "array" },
        "priority": { "type": "string", "enum": ["LOW", "NORMAL", "HIGH", "URGENT"] },
        "status": { "type": "string", "enum": ["NEW", "IN_PROGRESS", "WAITING", "COMPLETED", "OVERDUE", "ARCHIVED"] },
        "deadline": { "type": "string", "format": "date-time" },
        "progressSummary": { "type": "number" },
        "deleted": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["taskId", "projectId", "title", "assignerId", "assigneeIds", "priority", "status", "deadline", "createdAt", "updatedAt"]
    },
    "Notification": {
      "title": "Notification",
      "description": "In-app notifications for task assignments, updates, and chat messages",
      "type": "object",
      "properties": {
        "notificationId": { "type": "string" },
        "userId": { "type": "string" },
        "type": { "type": "string" },
        "title": { "type": "string" },
        "body": { "type": "string" },
        "read": { "type": "boolean" },
        "deduplicationKey": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["notificationId", "userId", "type", "title", "body", "read", "deduplicationKey", "createdAt"]
    },
    "AuditEvent": {
      "title": "AuditEvent",
      "description": "Immutable append-only audit records for security and activity tracking",
      "type": "object",
      "properties": {
        "eventId": { "type": "string" },
        "actorId": { "type": "string" },
        "action": { "type": "string" },
        "entityType": { "type": "string" },
        "entityId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["eventId", "actorId", "action", "entityType", "entityId", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profiles with strict access rules"
    },
    "/projects/{projectId}": {
      "schema": { "$ref": "#/entities/Project" },
      "description": "Workspace projects"
    },
    "/tasks/{taskId}": {
      "schema": { "$ref": "#/entities/Task" },
      "description": "Task management records"
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/Notification" },
      "description": "User notification collection"
    },
    "/auditLogs/{eventId}": {
      "schema": { "$ref": "#/entities/AuditEvent" },
      "description": "Append-only immutable audit trail"
    }
  }
}
