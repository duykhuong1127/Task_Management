rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAuthenticated() {
      return request.auth != null;
    }

    function userDoc() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid));
    }

    function isActive() {
      return isAuthenticated()
        && userDoc().data.status == 'ACTIVE';
    }

    function isAdmin() {
      return isActive() && userDoc().data.role == 'ADMIN';
    }

    function projectDoc(projectId) {
      return firestore.get(/databases/(default)/documents/projects/$(projectId));
    }

    function taskDoc(taskId) {
      return firestore.get(/databases/(default)/documents/tasks/$(taskId));
    }

    function isProjectMember(projectId) {
      return isAdmin() || (
        isActive()
        && request.auth.uid in projectDoc(projectId).data.memberIds
      );
    }

    match /projects/{projectId}/tasks/{taskId}/{fileId}/{fileName} {
      allow read: if isProjectMember(projectId)
        && taskDoc(taskId).data.projectId == projectId;

      allow create: if isProjectMember(projectId)
        && taskDoc(taskId).data.projectId == projectId
        && request.resource.size > 0
        && request.resource.size <= 25 * 1024 * 1024
        && request.resource.metadata.projectId == projectId
        && request.resource.metadata.taskId == taskId
        && request.resource.metadata.fileId == fileId
        && request.resource.metadata.uploadedBy == request.auth.uid;

      // Binary objects are immutable. Replace by uploading a new file/version.
      allow update: if false;

      allow delete: if isProjectMember(projectId) && (
        isAdmin()
        || resource.metadata.uploadedBy == request.auth.uid
        || taskDoc(taskId).data.assignerId == request.auth.uid
      );
    }
  }
}
