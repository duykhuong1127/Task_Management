# Firebase Web App configuration (Firebase Console > Project settings > Your apps)
# These values identify the Firebase web app. Never place an OAuth client secret here.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# One-time migration only: set to "true" for an ADMIN browser when the cloud
# workspace is empty and you intentionally want to publish that browser's legacy
# LocalStorage projects/tasks to Firestore. Set back to "false" immediately after.
VITE_AUTO_MIGRATE_LOCAL_DATA="false"
